---
import { Icon } from 'astro-icon/components';

import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { FeatureTabs as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],
  orientation = 'vertical',
  isReversed = false,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const uid = id ?? `tabs-${Math.random().toString(36).slice(2, 8)}`;
const vertical = orientation === 'vertical';
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline as Record<string, string>} />

  <aw-tabs class:list={['block', vertical ? 'lg:grid lg:grid-cols-12 lg:gap-12 lg:items-center' : '']}>
    <div
      role="tablist"
      aria-orientation={vertical ? 'vertical' : 'horizontal'}
      class:list={[
        vertical
          ? ['flex flex-col gap-2 lg:col-span-5', isReversed ? 'lg:order-2' : '']
          : 'mb-8 flex flex-wrap justify-center gap-2',
      ]}
    >
      {
        items.map(({ title: tabTitle, description, icon }, index) => (
          <button
            type="button"
            role="tab"
            id={`${uid}-tab-${index}`}
            aria-controls={`${uid}-panel-${index}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
            class:list={[
              'group text-left rounded-lg border transition outline-offset-2',
              vertical
                ? 'flex gap-4 p-4 border-transparent aria-selected:border-gray-200 aria-selected:bg-white aria-selected:shadow-md dark:aria-selected:border-slate-700 dark:aria-selected:bg-slate-900 hover:bg-gray-50 dark:hover:bg-slate-800/60'
                : 'flex items-center gap-2 px-4 py-2 border-gray-200 dark:border-slate-700 aria-selected:bg-primary aria-selected:border-primary aria-selected:text-white hover:border-primary/50',
            ]}
          >
            {icon && (
              <Icon
                name={icon}
                class:list={[
                  'shrink-0',
                  vertical ? 'mt-0.5 h-7 w-7 text-primary' : 'h-5 w-5 text-primary group-aria-selected:text-white',
                ]}
              />
            )}
            <span>
              <span class:list={['block font-bold', vertical ? 'text-lg text-heading' : 'text-sm']}>{tabTitle}</span>
              {vertical && description && <span class="mt-1 block text-muted" set:html={description} />}
            </span>
          </button>
        ))
      }
    </div>

    <div class:list={[vertical ? ['lg:col-span-7', isReversed ? 'lg:order-1' : ''] : '']}>
      {
        items.map(({ title: tabTitle, description, videoSrc }, index) => (
          <div
            role="tabpanel"
            id={`${uid}-panel-${index}`}
            aria-labelledby={`${uid}-tab-${index}`}
            tabindex="0"
            hidden={index !== 0}
            class="outline-offset-4"
          >
             {videoSrc && (
  <div class="w-full max-w-[325px] md:max-w-[550px] mx-auto iframe-wrapper" data-src={videoSrc} data-title={tabTitle}>
    {index === 0 ? (
      <iframe
        height="550"
        width="550"
        src={videoSrc}
        title={tabTitle}
        frameborder="0"
        class="w-full max-w-[325px] md:max-w-[550px] mx-auto"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; fullscreen; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        loading="lazy"
      />
    ) : null}
  </div>
)}

            {!vertical && description && (
              <p class="mx-auto mt-6 max-w-3xl text-center text-muted" set:html={description} />
            )}
          </div>
        ))
      }
    </div>
  </aw-tabs>
</WidgetWrapper>
<script>
  class AwTabs extends HTMLElement {
    connectedCallback() {
      const tabs = Array.from(this.querySelectorAll('[role="tab"]')) as HTMLButtonElement[];
      const panels = Array.from(this.querySelectorAll('[role="tabpanel"]')) as HTMLElement[];

      const select = (index: number, focus = false) => {
        tabs.forEach((tab, i) => {
          const active = i === index;
          const panel = panels[i];

          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
          if (panel) {
            panel.hidden = !active;
          }

          const wrapper = panel?.querySelector('.iframe-wrapper') as HTMLElement | null;

          if (wrapper) {
            const videoSrc = wrapper.dataset.src;
            const videoTitle = wrapper.dataset.title || '';

            if (active) {
              // Create and inject the iframe fresh when selected
              if (videoSrc && !wrapper.querySelector('iframe')) {
                const iframe = document.createElement('iframe');
                iframe.height = '550';
                iframe.width = '550';
                iframe.src = videoSrc;
                iframe.title = videoTitle;
                iframe.setAttribute('frameborder', '0');
                iframe.className = "w-full max-w-[325px] md:max-w-[550px] mx-auto";
                iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; fullscreen; gyroscope; picture-in-picture; web-share');
                iframe.setAttribute('allowfullscreen', '');
                iframe.setAttribute('loading', 'lazy');
                wrapper.appendChild(iframe);
              }
            } else {
              // Completely destroy the iframe element to stop background audio/video
              const iframe = wrapper.querySelector('iframe');
              if (iframe) {
                iframe.remove();
              }
            }
          }
        });

        if (focus && tabs[index]) {
          tabs[index].focus();
        }
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => select(index));

        tab.addEventListener('keydown', (event: KeyboardEvent) => {
          const keys: Record<string, number> = {
            ArrowRight: index + 1,
            ArrowDown: index + 1,
            ArrowLeft: index - 1,
            ArrowUp: index - 1,
            Home: 0,
            End: tabs.length - 1,
          };

          if (!(event.key in keys)) return;

          event.preventDefault();
          select((keys[event.key] + tabs.length) % tabs.length, true);
        });
      });

      const activeIndex = tabs.findIndex(
        (tab) => tab.getAttribute('aria-selected') === 'true'
      );

      select(activeIndex >= 0 ? activeIndex : 0);
    }
  }

  if (!customElements.get('aw-tabs')) {
    customElements.define('aw-tabs', AwTabs);
  }
</script>


