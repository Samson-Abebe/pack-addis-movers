---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

// Compare paths without trailing slashes so the active link is detected
const isActive = (href?: string) => typeof href === 'string' && `/${trimSlash(href)}` === currentPath;

const persistKey = `header-${Array.from(
  JSON.stringify({ links, actions, isSticky, isDark, isFullWidth, showToggleTheme, showRssFeed, position })
)
  .reduce((hash, char) => (hash * 31 + char.charCodeAt(0)) >>> 0, 7)
  .toString(36)}`;
---

<aw-header transition:persist={persistKey}>
  <header
    class:list={[
      { sticky: isSticky, relative: !isSticky, dark: isDark },
      'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out',
    ]}
    {...isSticky ? { 'data-aw-sticky-header': true } : {}}
    {...id ? { id } : {}}
  >
    <div class="absolute inset-0"></div>
    <div
      class:list={[
        'relative text-default py-3 px-3 lg:px-6 mx-auto w-full',
        {
          'lg:flex lg:justify-between': position !== 'center',
        },
        {
          'lg:grid lg:grid-cols-3 lg:items-center': position === 'center',
        },
        {
          'max-w-7xl': !isFullWidth,
        },
      ]}
    >
      <div class:list={[{ 'mr-auto rtl:mr-0 rtl:ml-auto': position === 'right' }, 'flex justify-between items-center']}>
        <a class="flex items-center" href={getHomePermalink()}>
          <Logo />
        </a>
        <div class="flex items-center lg:hidden">
          <ToggleMenu />
        </div>
      </div>
      <nav
        class="items-center w-full lg:w-auto hidden lg:flex lg:mx-5 text-default overflow-y-auto overflow-x-hidden lg:overflow-visible lg:justify-self-center max-h-[calc(100vh-5rem)] lg:max-h-none py-4 lg:py-0"
        aria-label="Main navigation"
      >
        <ul
          class="flex flex-col lg:flex-row lg:self-center w-full lg:w-auto text-xl lg:text-[0.9375rem] tracking-[0.01rem] font-medium lg:justify-center space-y-1 lg:space-y-0"
        >
          {
            links.map(({ text, href, links }) => (
              <li class={links?.length ? 'dropdown group' : ''}>
                {links?.length ? (
                  <>
                    <button
                      type="button"
                      class="hover:text-link dark:hover:text-white px-4 py-3 flex items-center justify-between w-full lg:w-auto whitespace-nowrap"
                    >
                      <span>{text}</span>
                      <Icon
                        name="tabler:chevron-down"
                        class="w-3.5 h-3.5 ml-2 lg:ml-0.5 rtl:ml-0 rtl:mr-0.5 transition-transform duration-200"
                      />
                    </button>
                    <ul class="dropdown-menu lg:backdrop-blur-md dark:lg:bg-slate-900 dark:lg:border dark:lg:border-slate-700/50 rounded lg:absolute pl-4 lg:pl-0 font-medium lg:bg-white/90 lg:min-w-[200px] drop-shadow-xl hidden lg:group-hover:block space-y-1 py-1 bg-gray-50/50 dark:bg-slate-800/50 lg:bg-white/90">
                      {links.map(({ text: text2, href: href2 }) => (
                        <li>
                          <a
                            class:list={[
                              'first:rounded-t last:rounded-b lg:hover:bg-gray-100 hover:text-link dark:hover:text-white dark:hover:bg-gray-700 py-2.5 px-5 block whitespace-nowrap text-lg lg:text-sm',
                              { 'aw-link-active': isActive(href2) },
                            ]}
                            href={href2}
                          >
                            {text2}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <a
                    class:list={[
                      'hover:text-link dark:hover:text-white px-4 py-3 flex items-center whitespace-nowrap',
                      { 'aw-link-active': isActive(href) },
                    ]}
                    href={href}
                  >
                    {text}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
      <div
        class:list={[
          { 'ml-auto rtl:ml-0 rtl:mr-auto': position === 'left' },
          'hidden lg:self-center lg:flex items-center lg:mb-0 fixed w-full lg:w-auto lg:static justify-end left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 lg:p-0 lg:justify-self-end bg-page lg:bg-transparent border-t lg:border-t-0 border-gray-200 dark:border-slate-800',
        ]}
      >
        <div class="items-center flex justify-between w-full lg:w-auto">
          <div class="flex">
            {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 lg:w-5 lg:h-5 lg:inline-block" />}
          </div>
          {
            actions?.length ? (
              <span class="ml-4 rtl:ml-0 rtl:mr-4">
                {actions.map((btnProps) => (
                  <Button {...btnProps} class="ml-2 py-2.5 px-5.5 lg:px-6 font-semibold shadow-none text-sm w-auto" />
                ))}
              </span>
            ) : (
              ''
            )
          }
        </div>
      </div>
    </div>
  </header>
</aw-header>

<style>
  aw-header {
    display: contents;
  }
</style>

<script>
  class AwHeader extends HTMLElement {
    private onScroll?: () => void;
    private mql?: MediaQueryList;
    private onMqlChange?: () => void;
    private onPageLoad = () => {
      this.updateActiveLinks();
      this.closeOpenDropdown();
    };

    connectedCallback() {
      const header = this.querySelector<HTMLElement>('#header');
      const toggle = this.querySelector<HTMLElement>('[data-aw-toggle-menu]');
      const nav = this.querySelector<HTMLElement>('#header nav');
      const lastChild = this.querySelector<HTMLElement>('#header > div > div:last-child');

      this.updateActiveLinks();
      document.addEventListener('astro:page-load', this.onPageLoad);

      const closeMenu = () => {
        toggle?.classList.remove('expanded');
        toggle?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('overflow-hidden');
        header?.classList.remove('h-screen', 'expanded', 'bg-page');
        nav?.classList.add('hidden');
        lastChild?.classList.add('hidden');
        
        // Reset mobile dropdowns when menu closes
        this.querySelectorAll('.dropdown-menu').forEach((menu) => menu.classList.add('hidden'));
        this.querySelectorAll('nav button svg').forEach((icon) => icon.classList.remove('rotate-180'));
      };

      // Mobile menu toggle.
      toggle?.addEventListener('click', () => {
        const expanded = toggle.classList.toggle('expanded');
        toggle.setAttribute('aria-expanded', String(expanded));
        document.body.classList.toggle('overflow-hidden');
        header?.classList.toggle('h-screen');
        header?.classList.toggle('expanded');
        header?.classList.toggle('bg-page');
        nav?.classList.toggle('hidden');
        lastChild?.classList.toggle('hidden');
      });

      // Mobile navigation click handling (Accordion for dropdowns & auto-close on link click)
      nav?.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const dropdownBtn = target.closest('button');

        // If clicking a mobile dropdown button, toggle its sub-menu reliably via parent container
        if (window.innerWidth < 1024 && dropdownBtn) {
          const dropdownLi = dropdownBtn.closest('li.dropdown');
          const dropdownMenu = dropdownLi?.querySelector('.dropdown-menu');

          if (dropdownMenu) {
            e.preventDefault();
            dropdownMenu.classList.toggle('hidden');
            const icon = dropdownBtn.querySelector('svg');
            if (icon) {
              icon.classList.toggle('rotate-180');
            }
            return;
          }
        }

        // If clicking a normal link or a submenu link on mobile, close the mobile menu
        if (window.innerWidth < 1024 && target.closest('a')) {
          closeMenu();
        }
      });

      // Close mobile menu when leaving mobile breakpoint
      this.mql = window.matchMedia('(max-width: 1023px)');
      this.onMqlChange = () => closeMenu();
      this.mql.addEventListener('change', this.onMqlChange);

      // Sticky header logic
      if (header?.hasAttribute('data-aw-sticky-header')) {
        let ticking = false;
        const applyStyles = () => {
          if (window.scrollY > 60) header.classList.add('scroll');
          else header.classList.remove('scroll');
          ticking = false;
        };
        this.onScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(applyStyles);
            ticking = true;
          }
        };
        applyStyles();
        document.addEventListener('scroll', this.onScroll, { passive: true });
      }

      document.documentElement.classList.add('motion-safe:scroll-smooth');
    }

    disconnectedCallback() {
      if (this.onScroll) document.removeEventListener('scroll', this.onScroll);
      if (this.mql && this.onMqlChange) this.mql.removeEventListener('change', this.onMqlChange);
      document.removeEventListener('astro:page-load', this.onPageLoad);
    }

    private closeOpenDropdown() {
      const active = document.activeElement as HTMLElement | null;
      if (active && this.contains(active) && active.closest('.dropdown')) active.blur();
    }

    private updateActiveLinks() {
      const norm = (p: string) => '/' + p.replace(/^\/+|\/+$/g, '');
      const current = norm(window.location.pathname);
      this.querySelectorAll<HTMLAnchorElement>('nav a[href]').forEach((a) => {
        const url = new URL(a.href, window.location.href);
        const isPathLink =
          url.origin === window.location.origin && !url.hash && !a.getAttribute('href')?.startsWith('#');
        a.classList.toggle('aw-link-active', isPathLink && norm(url.pathname) === current);
      });
    }
  }

  if (!customElements.get('aw-header')) {
    customElements.define('aw-header', AwHeader);
  }
</script>