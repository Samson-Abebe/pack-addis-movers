---
import { Icon } from 'astro-icon/components';
import type { Brands as Props } from '~/types';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  icons = [],
  images = [],
  variant = 'grid',
  grayscale = false,
  boxed = true,
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// Smooth transition with blue hover effects on link interaction
const logoClass = [
  'h-10 w-10 transition-all duration-300 transform group-hover:scale-110 group-hover:text-blue-600 dark:group-hover:text-blue-400',
  grayscale ? 'grayscale opacity-70 group-hover:grayscale-0 group-hover:opacity-100' : '',
].join(' ');

const boxClass = boxed
  ? 'py-3 px-5 rounded-xl bg-white/80 dark:bg-slate-800/80 backdrop-blur border border-slate-200/60 dark:border-slate-700/60 shadow-sm hover:shadow-md hover:border-blue-500/50 hover:bg-blue-50/50 dark:hover:bg-slate-800 transition-all'
  : 'p-3 rounded-lg transition-transform hover:bg-blue-50 dark:hover:bg-slate-800';

const isMarquee = variant === 'marquee';
const duration = `${Math.max(25, (icons.length + images.length) * 5)}s`;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline as Record<string, string>} />

  <div
    class:list={[
      'relative my-6',
      isMarquee
        ? 'aw-marquee overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]'
        : 'flex flex-wrap justify-center items-center gap-8 sm:gap-12',
    ]}
    style={isMarquee ? `--aw-marquee-duration: ${duration}` : undefined}
  >
    {
      [0, ...(isMarquee ? [1] : [])].map((copy) => (
        <div
          class:list={[
            isMarquee ? 'aw-marquee-track flex shrink-0 items-center gap-10 lg:gap-14 pr-10 lg:pr-14' : 'contents',
          ]}
          aria-hidden={copy === 1 ? 'true' : undefined}
        >
          {/* Icon Array Support */}
          {icons &&
            icons.map((item) => {
              const iconName = typeof item === 'string' ? item : item.name;
              const iconHref = typeof item === 'object' && item !== null ? item.href : undefined;

              const iconElement = (
                <Icon name={iconName} class:list={['text-gray-600 dark:text-gray-300', logoClass]} />
              );

              return iconHref ? (
                <a
                  href={iconHref}
                  class:list={['group flex items-center justify-center', boxClass]}
                  target="_blank"
                  rel="noopener noreferrer"
                  tabindex={copy === 1 ? -1 : undefined}
                >
                  {iconElement}
                </a>
              ) : (
                <div class:list={['group flex items-center justify-center', boxClass]}>
                  {iconElement}
                </div>
              );
            })}

          {/* Image Array Support */}
          {images &&
            images.map(
              (image) =>
                image.src &&
                (image.href ? (
                  <a
                    href={image.href}
                    class:list={['group flex items-center justify-center my-2', boxClass]}
                    target="_blank"
                    rel="noopener noreferrer"
                    tabindex={copy === 1 ? -1 : undefined}
                  >
                    <img
                      src={image.src}
                      alt={image.alt || 'Social icon'}
                      class="h-10 w-auto max-w-[100px] object-contain transition-all duration-300 transform group-hover:scale-110"
                      loading="lazy"
                    />
                  </a>
                ) : (
                  <div class:list={['group flex items-center justify-center my-2', boxClass]}>
                    <img
                      src={image.src}
                      alt={image.alt || 'Social icon'}
                      class="h-10 w-auto max-w-[100px] object-contain transition-all duration-300 transform group-hover:scale-110"
                      loading="lazy"
                    />
                  </div>
                ))
            )}
        </div>
      ))
    }
  </div>
</WidgetWrapper>

<style>
  .aw-marquee {
    display: flex;
  }
  .aw-marquee-track {
    animation: aw-marquee var(--aw-marquee-duration, 30s) linear infinite;
  }
  .aw-marquee:hover .aw-marquee-track {
    animation-play-state: paused;
  }
  @keyframes aw-marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .aw-marquee {
      flex-wrap: wrap;
      justify-content: center;
      mask-image: none;
    }
    .aw-marquee-track {
      animation: none;
      flex-shrink: 1;
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
      padding-right: 0;
    }
    .aw-marquee-track[aria-hidden='true'] {
      display: none;
    }
  }
</style>