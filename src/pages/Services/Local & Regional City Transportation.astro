---
import Layout from '~/layouts/LandingLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';

import StickyCTA from '~/components/widgets/StickyCTA.astro';
import Timeline from '~/components/widgets/Timeline.astro';






const destination = 'https://github.com/arthelokyo/astrowind';

const metadata = {
  title: 'Click-Through Landing Page Example & Guide',
  description:
    'A complete click-through landing page built with AstroWind: message match, one destination, preview of what comes next, proof and FAQ, with notes on why each block moves the click. Free Astro template.',
  openGraph: { type: 'website' },
};
---

<Layout metadata={metadata}>
  <!-- 1. Hero: the promise and the first click to the destination -->

<Hero2
  tagline="Nationwide Freight & Transport"
  title="Reliable Intercity Relocation Across Ethiopia!"
  subtitle="Connect your move anywhere in the country with Trustpack and Move. We provide safe, reliable transit from Addis Ababa to different regions and parts of the country. Whether you are moving household goods, corporate offices, or retail stock to regional hubs, our long-distance fleet and real-time communication ensure your cargo arrives safely and on time."
  image={{
    src: 'https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
    alt: 'Highway Freight Truck Transport Across Regions',
    class: 'w-full h-auto object-contain max-h-none',
  }}
/>

  

  <!-- 2. What the page is for -->


  <!-- 3. What to put on it -->


  <!-- 4. The journey the visitor takes -->


  <!-- 5. Rules of thumb -->

  <Timeline
    id="roadmap"
 tagline="Regional Process"
title="Long-Distance Transit Planned for Safety & Speed"
subtitle="Ensuring smooth passage and 100% item safety from Addis Ababa to every corner of Ethiopia."
items={[
  {
    date: 'Step 1',
    title: 'Route Planning & Dispatch Scheduling',
    description:
      'We plan regional transit routes, verify road conditions, and prepare proper transit documentation for regional highway checkpoints.',
    icon: 'tabler:map-pin',
    highlight: true,
  },
  {
    date: 'Step 2',
    title: 'Vibration & Shockproof Packaging',
    description:
      'Cargo is reinforced with thick corrugated boxes, heavy-duty straps, and shock-absorbing bubble wrap to withstand long-distance road conditions.',
    icon: 'tabler:box-seam',
  },
  {
    date: 'Step 3',
    title: 'Intercity Highway Transit',
    description:
      'Experienced long-haul drivers transport your items safely from Addis Ababa across regional cities with dedicated tracking updates.',
    icon: 'tabler:truck',
  },
  {
    date: 'Step 4',
    title: 'On-Site Delivery & Setup',
    description:
      'Upon arrival in the destination city, our regional crew unloads, unpacks, and reassembles your furniture and appliances in your new space.',
    icon: 'tabler:map-check',
  },
]}

    >
      <Fragment slot="bg">
      <div
        class="absolute inset-0 bg-[radial-gradient(60%_55%_at_15%_20%,rgb(129_140_248/0.28),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(244_114_182/0.22),transparent_65%)] dark:bg-[radial-gradient(60%_55%_at_15%_20%,rgb(99_102_241/0.25),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(217_70_239/0.18),transparent_65%)]"
      >
      </div>
    </Fragment>
</Timeline>


  <!-- On phones the hero button is long gone; the bar brings the click back once the reader scrolls -->

  <StickyCTA text="Get the template" href={destination} target="_blank" label="One destination, three placements" />
</Layout>
