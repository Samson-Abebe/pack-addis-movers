---
import Layout from '~/layouts/LandingLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';

import StickyCTA from '~/components/widgets/StickyCTA.astro';
import Timeline from '~/components/widgets/Timeline.astro';






const destination = 'https://github.com/arthelokyo/astrowind';

const metadata = {
  title: 'Click-Through Landing Page Example & Guide',
  description:
    'A complete click-through landing page built with AstroWind: message match, one destination, preview of what comes next, proof and FAQ, with notes on why each block moves the click. Free Astro template.',
  openGraph: { type: 'website' },
};
---

<Layout metadata={metadata}>
  <!-- 1. Hero: the promise and the first click to the destination -->

<Hero2
  tagline="Commercial Office Logistics"
  title="Professional Office Relocation & Equipment Transit!"
  subtitle="Minimize business downtime with corporate moving solutions from Trustpack and Move. We specialize in the professional handling of office desks, chairs, files, and electronic equipment. From dismantling workstations and organizing sensitive document files to reassembling conference rooms (as demonstrated with Trade Link PLC), our team guarantees a swift, secure office move."
  image={{
    src: 'https://images.unsplash.com/photo-1497366216548-37526070297c?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
    alt: 'Professional Handling of Office Desks Chairs and Equipment',
    class: 'w-full h-auto object-contain max-h-none',
  }}
/>
  

  <!-- 2. What the page is for -->


  <!-- 3. What to put on it -->


  <!-- 4. The journey the visitor takes -->


  <!-- 5. Rules of thumb -->

  <Timeline
    id="roadmap"
tagline="Office Relocation Process"
title="Efficient Moving Tailored to Preserve Business Hours"
subtitle="Designed for seamless workspace transitions with zero data or equipment compromise."
items={[
  {
    date: 'Step 1',
    title: 'Inventory & Office Layout Planning',
    description:
      'We catalog office desks, chairs, filing cabinets, and electronic equipment to map out a systematic packing and labeling schedule.',
    icon: 'tabler:sitemap',
    highlight: true,
  },
  {
    date: 'Step 2',
    title: 'Professional Handling & Packing',
    description:
      'Workstations are dismantled and files/IT electronics are packed securely using shockproof padding and organized labeling.',
    icon: 'tabler:building',
  },
  {
    date: 'Step 3',
    title: 'Secure Fleet Transport',
    description:
      'Your entire office setup is loaded into large commercial trucks for rapid, high-security transit to your new business facility.',
    icon: 'tabler:truck-loading',
  },
  {
    date: 'Step 4',
    title: 'Workstation Setup & Reassembly',
    description:
      'We reassemble desks, chairs, monitors, and filing systems according to your floor plan so your team can get straight back to work.',
    icon: 'tabler:briefcase',
  },
]}
    >
      <Fragment slot="bg">
      <div
        class="absolute inset-0 bg-[radial-gradient(60%_55%_at_15%_20%,rgb(129_140_248/0.28),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(244_114_182/0.22),transparent_65%)] dark:bg-[radial-gradient(60%_55%_at_15%_20%,rgb(99_102_241/0.25),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(217_70_239/0.18),transparent_65%)]"
      >
      </div>
    </Fragment>
</Timeline>


  <!-- On phones the hero button is long gone; the bar brings the click back once the reader scrolls -->

  <StickyCTA text="Get the template" href={destination} target="_blank" label="One destination, three placements" />
</Layout>
