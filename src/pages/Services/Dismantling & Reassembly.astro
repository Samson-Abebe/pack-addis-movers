---
import Layout from '~/layouts/LandingLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';

import StickyCTA from '~/components/widgets/StickyCTA.astro';
import Timeline from '~/components/widgets/Timeline.astro';






const destination = 'https://github.com/arthelokyo/astrowind';

const metadata = {
  title: 'Click-Through Landing Page Example & Guide',
  description:
    'A complete click-through landing page built with AstroWind: message match, one destination, preview of what comes next, proof and FAQ, with notes on why each block moves the click. Free Astro template.',
  openGraph: { type: 'website' },
};
---

<Layout metadata={metadata}>
  <!-- 1. Hero: the promise and the first click to the destination -->

<Hero2
  tagline="Furniture & Appliance Assembly"
  title="Expert Dismantling & Reassembly Services!"
  subtitle="Take the complexity out of large furniture and electronics with Trustpack and Move. We provide expert dismantling and setup of TVs, beds, wardrobes, and office furniture. Our skilled technicians ensure hardware is carefully unmounted, transported safely without missing screws or components, and precisely reassembled or wall-mounted at your new location."
  image={{
    src: 'https://images.unsplash.com/photo-1581539250439-c96689b516dd?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
    alt: 'Expert Dismantling and Setup of Furniture and TVs',
    class: 'w-full h-auto object-contain max-h-none',
  }}
/>

  

  <!-- 2. What the page is for -->


  <!-- 3. What to put on it -->


  <!-- 4. The journey the visitor takes -->


  <!-- 5. Rules of thumb -->

  <Timeline
    id="roadmap"
 tagline="Assembly Workflow"
title="Precision Unmounting, Hardware Care & Rebuilding"
subtitle="Ensuring complex furniture and wall-mounted electronics are reconstructed perfectly."
items={[
  {
    date: 'Step 1',
    title: 'Component Inspection & Unmounting',
    description:
      'We inspect structural joints, safely unmount large smart TVs, and organize hardware fasteners into protective bags.',
    icon: 'tabler:tools',
    highlight: true,
  },
  {
    date: 'Step 2',
    title: 'Careful Dismantling',
    description:
      'Our carpenters perform expert dismantling of beds, wardrobes, executive desks, and wall units without scratching wood or metal.',
    icon: 'tabler:armchair-off',
  },
  {
    date: 'Step 3',
    title: 'Flat-Pack Protective Transport',
    description:
      'Dismantled panels and screen units are padded in bubble wrap and corner guards for flat, stable transit.',
    icon: 'tabler:truck-loading',
  },
  {
    date: 'Step 4',
    title: 'Expert Reassembly & Mounting',
    description:
      'At the destination, we complete full setup of TVs, beds, wardrobes, and office furniture so they are ready for immediate use.',
    icon: 'tabler:armchair',
  },

]}

    >
      <Fragment slot="bg">
      <div
        class="absolute inset-0 bg-[radial-gradient(60%_55%_at_15%_20%,rgb(129_140_248/0.28),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(244_114_182/0.22),transparent_65%)] dark:bg-[radial-gradient(60%_55%_at_15%_20%,rgb(99_102_241/0.25),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(217_70_239/0.18),transparent_65%)]"
      >
      </div>
    </Fragment>
</Timeline>


  <!-- On phones the hero button is long gone; the bar brings the click back once the reader scrolls -->

  <StickyCTA text="Get the template" href={destination} target="_blank" label="One destination, three placements" />
</Layout>
