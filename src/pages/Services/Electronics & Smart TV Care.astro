---
import Layout from '~/layouts/LandingLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';

import StickyCTA from '~/components/widgets/StickyCTA.astro';
import Timeline from '~/components/widgets/Timeline.astro';






const destination = 'https://github.com/arthelokyo/astrowind';

const metadata = {
  title: 'Click-Through Landing Page Example & Guide',
  description:
    'A complete click-through landing page built with AstroWind: message match, one destination, preview of what comes next, proof and FAQ, with notes on why each block moves the click. Free Astro template.',
  openGraph: { type: 'website' },
};
---

<Layout metadata={metadata}>
  <!-- 1. Hero: the promise and the first click to the destination -->

<Hero2
  tagline="Electronics & Smart TV Care"
  title="Specialized TV Mounting & High-Value Electronics Transport!"
  subtitle="Protect your expensive display screens and high-tech devices with Trustpack and Move. We provide specialized transport and safe installation of large smart TVs (65”, 75”, 100” and above) using custom protective packaging. Our technicians handle complete unmounting, custom padding, shockproof transit, precise wall installation, and testing—ensuring your valuable electronics are relocated with zero risk of screen or internal damage."
  image={{
    src: 'https://images.unsplash.com/photo-1593359677879-a4bb92f829d1?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
    alt: 'Large Smart TV and Home Entertainment System Setup',
    class: 'w-full h-auto object-contain max-h-none',
  }}
/>

  

  <!-- 2. What the page is for -->


  <!-- 3. What to put on it -->


  <!-- 4. The journey the visitor takes -->


  <!-- 5. Rules of thumb -->

  <Timeline
id="roadmap"
tagline="Electronics Process"
title="Precision Packing & Professional Installation"
subtitle="A complete step-by-step procedure designed specifically for high-value smart TVs and delicate tech hardware."
items={[
  {
    date: 'Step 1',
    title: 'Screen Assessment & Unmounting',
    description:
      'Our technical team inspects your display hardware, safely unmounts large screens (65"-100"+), and disconnects all wiring system components.',
    icon: 'tabler:device-tv',
    highlight: true,
  },
  {
    date: 'Step 2',
    title: 'Custom Multi-Layer Shockproof Crate/Wrap',
    description:
      'We prepare specialized shock-absorbing bubble packaging and custom cardboard encasements engineered specifically for fragile digital displays.',
    icon: 'tabler:box-padding',
  },
  {
    date: 'Step 3',
    title: 'Padded Transit',
    description:
      'Screens are secured in dedicated vehicle compartments to eliminate movement, vibration, or impact risks during transport across the city.',
    icon: 'tabler:shield-checkered',
  },
  {
    date: 'Step 4',
    title: 'Wall Mounting & Testing',
    description:
      'At your new location, we safely remount your smart TV onto the wall, reconnect all entertainment systems, and verify full functionality.',
    icon: 'tabler:player-play',
  },
]}
  

    >
      <Fragment slot="bg">
      <div
        class="absolute inset-0 bg-[radial-gradient(60%_55%_at_15%_20%,rgb(129_140_248/0.28),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(244_114_182/0.22),transparent_65%)] dark:bg-[radial-gradient(60%_55%_at_15%_20%,rgb(99_102_241/0.25),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(217_70_239/0.18),transparent_65%)]"
      >
      </div>
    </Fragment>
</Timeline>


  <!-- On phones the hero button is long gone; the bar brings the click back once the reader scrolls -->

  <StickyCTA text="Get the template" href={destination} target="_blank" label="One destination, three placements" />
</Layout>
