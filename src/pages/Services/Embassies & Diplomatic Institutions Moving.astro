---
import Layout from '~/layouts/LandingLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';

import StickyCTA from '~/components/widgets/StickyCTA.astro';
import Timeline from '~/components/widgets/Timeline.astro';






const destination = 'https://github.com/arthelokyo/astrowind';

const metadata = {
  title: 'Click-Through Landing Page Example & Guide',
  description:
    'A complete click-through landing page built with AstroWind: message match, one destination, preview of what comes next, proof and FAQ, with notes on why each block moves the click. Free Astro template.',
  openGraph: { type: 'website' },
};
---

<Layout metadata={metadata}>
  <!-- 1. Hero: the promise and the first click to the destination -->

  <Hero2
  tagline="Diplomatic & High-Security Relocation"
  title="Secure & Highly Confidential Diplomatic Moving Services!"
  subtitle="Entrust your mission-critical relocations to Ethiopia’s premier secure moving team. Trustpack and Move offers secure, highly confidential transport designed for sensitive and diplomatic requirements. Serving international embassies, consulates, and international agencies, we enforce strict chain-of-custody protocols, background-checked personnel, sealed transit options, and seamless logistics tailored to meet international security standards."
  image={{
    src: 'https://images.unsplash.com/photo-1541872703-74c5e44368f9?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
    alt: 'Diplomatic Architecture and Official Institutional Facility',
    class: 'w-full h-auto object-contain max-h-none',
  }}
/>

  

  <!-- 2. What the page is for -->


  <!-- 3. What to put on it -->


  <!-- 4. The journey the visitor takes -->


  <!-- 5. Rules of thumb -->

  <Timeline
    id="roadmap"
 tagline="Diplomatic Protocol"
title="Confidentiality, Chain of Custody & Precision"
subtitle="A specialized relocation methodology adhering strictly to official protocol and security requirements."
items={[
  {
    date: 'Step 1',
    title: 'Security Clearance & Pre-Move Audit',
    description:
      'We coordinate with mission security officers to audit sensitive inventory, establish access protocols, and assign cleared, vetted personnel.',
    icon: 'tabler:lock',
    highlight: true,
  },
  {
    date: 'Step 2',
    title: 'Tamper-Evident Packing & Tagging',
    description:
      'Official documents, high-confidentiality assets, and executive furnishings are wrapped and secured in numbered, tamper-evident containers.',
    icon: 'tabler:file-certificate',
  },
  {
    date: 'Step 3',
    title: 'Escorted & Direct Transit',
    description:
      'We utilize dedicated, sealed transport vehicles taking direct routes across Addis Ababa or regional cities under 100% security oversight.',
    icon: 'tabler:truck',
  },
  {
    date: 'Step 4',
    title: 'Unsealing, Placement & Verification',
    description:
      'Containers are unsealed strictly in the presence of designated embassy supervisors, followed by immediate setup and room restoration.',
    icon: 'tabler:user-check',
  },
]}
  

    >
      <Fragment slot="bg">
      <div
        class="absolute inset-0 bg-[radial-gradient(60%_55%_at_15%_20%,rgb(129_140_248/0.28),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(244_114_182/0.22),transparent_65%)] dark:bg-[radial-gradient(60%_55%_at_15%_20%,rgb(99_102_241/0.25),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(217_70_239/0.18),transparent_65%)]"
      >
      </div>
    </Fragment>
</Timeline>


  <!-- On phones the hero button is long gone; the bar brings the click back once the reader scrolls -->

  <StickyCTA text="Get the template" href={destination} target="_blank" label="One destination, three placements" />
</Layout>
