---
import Layout from '~/layouts/LandingLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';

import StickyCTA from '~/components/widgets/StickyCTA.astro';
import Timeline from '~/components/widgets/Timeline.astro';






const destination = 'https://github.com/arthelokyo/astrowind';

const metadata = {
  title: 'Click-Through Landing Page Example & Guide',
  description:
    'A complete click-through landing page built with AstroWind: message match, one destination, preview of what comes next, proof and FAQ, with notes on why each block moves the click. Free Astro template.',
  openGraph: { type: 'website' },
};
---

<Layout metadata={metadata}>
  <!-- 1. Hero: the promise and the first click to the destination -->


<Hero2
  tagline="Full Residential Moving"
  title="Smooth & Damage-Free Moving for Any Residence!"
  subtitle="Relocate effortlessly across Addis Ababa and beyond with Trustpack and Move. We deliver smooth relocation of villas, apartments, condominiums, and high-rise buildings with zero damage guaranteed. Our expert team takes 100% responsibility for your home assets—handling everything from high-altitude balcony and elevator logistics to premium protective packing, safe transport, careful unpacking, and complete furniture setup in as little as 4 hours."
  image={{
    src: 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
    alt: 'Modern Residential Apartment Building and Relocation',
    class: 'w-full h-auto object-contain max-h-none',
  }}
/>

  

  <!-- 2. What the page is for -->


  <!-- 3. What to put on it -->


  <!-- 4. The journey the visitor takes -->


  <!-- 5. Rules of thumb -->

  <Timeline
    id="roadmap"
tagline="Residential Process"
title="Seamless Relocation for Villas, Apartments & Condos"
subtitle="Our structured moving methodology guarantees complete safety and zero damage, no matter the building type or floor height."
items={[
  {
    date: 'Step 1',
    title: 'Pre-Move Survey & Floor Assessment',
    description:
      'We review your building layout, floor levels, stairwells, and elevator access via photos, videos, or an on-site visit to plan a safe, seamless move.',
    icon: 'tabler:building-skyscraper',
    highlight: true,
  },
  {
    date: 'Step 2',
    title: 'Multi-Layer Protective Packing',
    description:
      'Every piece of furniture and fragile item is wrapped in custom cardboard, plastic film, and high-density bubble wrap to prevent scratch or impact damage.',
    icon: 'tabler:box-margin',
  },
  {
    date: 'Step 3',
    title: 'Safe Transit & Floor Navigation',
    description:
      'We safely transport items from villas, apartments, condominiums, and high-rise buildings using specialized equipment and secure transit vehicles.',
    icon: 'tabler:truck-loading',
  },
  {
    date: 'Step 4',
    title: 'Unpacking, Reassembly & Zero-Damage Setup',
    description:
      'Our experts carefully unpack, reassemble beds and wardrobes, mount large TVs, and arrange your home to ensure 100% satisfaction with zero damage.',
    icon: 'tabler:home-check',
  },
]}
    >
      <Fragment slot="bg">
      <div
        class="absolute inset-0 bg-[radial-gradient(60%_55%_at_15%_20%,rgb(129_140_248/0.28),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(244_114_182/0.22),transparent_65%)] dark:bg-[radial-gradient(60%_55%_at_15%_20%,rgb(99_102_241/0.25),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(217_70_239/0.18),transparent_65%)]"
      >
      </div>
    </Fragment>
</Timeline>


  <!-- On phones the hero button is long gone; the bar brings the click back once the reader scrolls -->

  <StickyCTA text="Get the template" href={destination} target="_blank" label="One destination, three placements" />
</Layout>
