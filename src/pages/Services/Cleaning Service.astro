---
import Layout from '~/layouts/LandingLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';

import StickyCTA from '~/components/widgets/StickyCTA.astro';
import Timeline from '~/components/widgets/Timeline.astro';






const destination = 'https://github.com/arthelokyo/astrowind';

const metadata = {
  title: 'Click-Through Landing Page Example & Guide',
  description:
    'A complete click-through landing page built with AstroWind: message match, one destination, preview of what comes next, proof and FAQ, with notes on why each block moves the click. Free Astro template.',
  openGraph: { type: 'website' },
};
---

<Layout metadata={metadata}>
  <!-- 1. Hero: the promise and the first click to the destination -->
<Hero2
  tagline="Pre-Move & Post-Move Cleaning"
  title="Thorough Home & Office Cleaning Services!"
  subtitle="Step into a fresh, spotless space with Trustpack and Move. We deliver thorough pre-move or post-move cleaning for your home or office space. Our cleaning crews sanitize floors, clean windows, scrub kitchens and bathrooms, and remove move-in dust—leaving your old space pristine for handover and your new location ready for living."
  image={{
    src: 'https://images.unsplash.com/photo-1581578731548-c64695cc6952?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
    alt: 'Thorough Pre-Move or Post-Move Cleaning for Home or Office',
    class: 'w-full h-auto object-contain max-h-none',
  }}
/>

  

  <!-- 2. What the page is for -->


  <!-- 3. What to put on it -->


  <!-- 4. The journey the visitor takes -->


  <!-- 5. Rules of thumb -->

  <Timeline
id="roadmap"
tagline="Cleaning Workflow"
title="Deep Sanitation Before You Move In or After You Leave"
subtitle="Comprehensive cleaning packages tailored for residential and commercial spaces."
items={[
  {
    date: 'Step 1',
    title: 'Space Inspection & Scope',
    description:
      'We evaluate the square footage and specific requirements (windows, deep scrubbing, trash clearing) for your home or office.',
    icon: 'tabler:search',
    highlight: true,
  },
  {
    date: 'Step 2',
    title: 'Post-Move Empty Cleaning',
    description:
      'Once items are loaded out, our team carries out thorough post-move cleaning so you can hand back keys hassle-free.',
    icon: 'tabler:brush',
  },
  {
    date: 'Step 3',
    title: 'Pre-Move Preparation & Sanitization',
    description:
      'We perform thorough pre-move cleaning at your new space, scrubbing surfaces, dusting fixtures, and washing floors before furniture arrives.',
    icon: 'tabler:sparkles',
  },
  {
    date: 'Step 4',
    title: 'Spotless Handover',
    description:
      'You receive a completely sanitized, fresh environment ready for immediate move-in and comfortable living or working.',
    icon: 'tabler:circle-check',
  },
]}
  

    >
      <Fragment slot="bg">
      <div
        class="absolute inset-0 bg-[radial-gradient(60%_55%_at_15%_20%,rgb(129_140_248/0.28),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(244_114_182/0.22),transparent_65%)] dark:bg-[radial-gradient(60%_55%_at_15%_20%,rgb(99_102_241/0.25),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(217_70_239/0.18),transparent_65%)]"
      >
      </div>
    </Fragment>
</Timeline>


  <!-- On phones the hero button is long gone; the bar brings the click back once the reader scrolls -->

  <StickyCTA text="Get the template" href={destination} target="_blank" label="One destination, three placements" />
</Layout>
