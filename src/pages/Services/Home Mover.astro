---
import Layout from '~/layouts/LandingLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';

import StickyCTA from '~/components/widgets/StickyCTA.astro';
import Timeline from '~/components/widgets/Timeline.astro';






const destination = 'https://github.com/arthelokyo/astrowind';

const metadata = {
  title: 'Click-Through Landing Page Example & Guide',
  description:
    'A complete click-through landing page built with AstroWind: message match, one destination, preview of what comes next, proof and FAQ, with notes on why each block moves the click. Free Astro template.',
  openGraph: { type: 'website' },
};
---

<Layout metadata={metadata}>
  <!-- 1. Hero: the promise and the first click to the destination -->

<Hero2
  tagline="Residential Moving Experts"
  title="Careful Unpacking, Packing & Home Relocation!"
  subtitle="Enjoy a completely hassle-free home transition with Trustpack and Move. We take 100% responsibility for carefully unpacking, packing, and relocating household items across Addis Ababa and beyond. From delicate kitchenware and personal belongings to heavy furniture, our professional crew handles your move end-to-end in as little as 4 hours—protecting your home assets and saving you days of stressful effort."
  image={{
   src: '~/assets/images/home_m.png',
    alt: 'Careful Unpacking and Relocating Household Items',
    class: 'w-full h-auto object-contain max-h-none',
  }}
/>

  

  <!-- 2. What the page is for -->


  <!-- 3. What to put on it -->


  <!-- 4. The journey the visitor takes -->


  <!-- 5. Rules of thumb -->

  <Timeline
    id="roadmap"
  tagline="Home Moving Process"
title="Structured & Gentle Handling for Every Household Item"
subtitle="A complete step-by-step procedure designed to make moving your home safe, organized, and effortless."
items={[
  {
    date: 'Step 1',
    title: 'Home Assessment & Quote',
    description:
      'Send photos or videos via Telegram/WhatsApp or invite our supervisor for an on-site survey to receive an all-inclusive moving quote.',
    icon: 'tabler:clipboard-text',
    highlight: true,
  },
  {
    date: 'Step 2',
    title: 'Careful Packing',
    description:
      'Our team arrives with premium cardboard, plaster, and bubble wrap for carefully unpacking, packing, and preparing your household items.',
    icon: 'tabler:box',
  },
  {
    date: 'Step 3',
    title: 'Protected Transit',
    description:
      'We safely transport all your belongings across town in specialized trucks, eliminating risks of breakage or property damage.',
    icon: 'tabler:truck',
  },
  {
    date: 'Step 4',
    title: 'Unpacking & Room Setup',
    description:
      'We finish by carefully unpacking, reassembling furniture, and arranging household items in your new home so you can settle in immediately.',
    icon: 'tabler:home-check',
  },
]}
  

    >
      <Fragment slot="bg">
      <div
        class="absolute inset-0 bg-[radial-gradient(60%_55%_at_15%_20%,rgb(129_140_248/0.28),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(244_114_182/0.22),transparent_65%)] dark:bg-[radial-gradient(60%_55%_at_15%_20%,rgb(99_102_241/0.25),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(217_70_239/0.18),transparent_65%)]"
      >
      </div>
    </Fragment>
</Timeline>


  <!-- On phones the hero button is long gone; the bar brings the click back once the reader scrolls -->

  <StickyCTA text="Get the template" href={destination} target="_blank" label="One destination, three placements" />
</Layout>
