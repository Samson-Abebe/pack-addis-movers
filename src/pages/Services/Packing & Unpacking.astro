---
import Layout from '~/layouts/LandingLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';

import StickyCTA from '~/components/widgets/StickyCTA.astro';
import Timeline from '~/components/widgets/Timeline.astro';






const destination = 'https://github.com/arthelokyo/astrowind';

const metadata = {
  title: 'Click-Through Landing Page Example & Guide',
  description:
    'A complete click-through landing page built with AstroWind: message match, one destination, preview of what comes next, proof and FAQ, with notes on why each block moves the click. Free Astro template.',
  openGraph: { type: 'website' },
};
---

<Layout metadata={metadata}>
  <!-- 1. Hero: the promise and the first click to the destination -->
<Hero2
  tagline="Full-Service Packaging"
  title="Secure Wrapping & Complete Unpacking Solutions!"
  subtitle="Eliminate the most exhausting part of moving with Trustpack and Move. We provide secure wrapping using high-grade cardboard, plastic, and bubble wrap to shield every item from scratch or impact. Our dedicated packers supply all protective materials, wrap fragile goods with surgical care, and unpack everything right into place at your destination."
  image={{
    src: 'https://images.unsplash.com/photo-1584622650111-993a426fbf0a?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
    alt: 'Secure Wrapping Using High-Grade Cardboard Plastic and Bubble Wrap',
    class: 'w-full h-auto object-contain max-h-none',
  }}
/>

  

  <!-- 2. What the page is for -->


  <!-- 3. What to put on it -->


  <!-- 4. The journey the visitor takes -->


  <!-- 5. Rules of thumb -->

  <Timeline
    id="roadmap"
 tagline="Packing Workflow"
title="Multi-Layer Wrapping for Total Damage Prevention"
subtitle="Top-tier materials applied systematically to guarantee 100% safety during transport."
items={[
  {
    date: 'Step 1',
    title: 'Material Delivery & Preparation',
    description:
      'We bring heavy-duty cardboard boxes, plaster, stretch plastic wrap, and premium bubble wrap directly to your door.',
    icon: 'tabler:box-seam',
    highlight: true,
  },
  {
    date: 'Step 2',
    title: 'Secure Wrapping',
    description:
      'Every delicate piece, glass top, and surface undergoes secure wrapping using high-grade cardboard, plastic, and bubble wrap.',
    icon: 'tabler:shield-check',
  },
  {
    date: 'Step 3',
    title: 'Safe Transit',
    description:
      'Packed boxes and wrapped furniture are loaded in cushioned vehicle sections for zero movement during transportation.',
    icon: 'tabler:package-export',
  },
  {
    date: 'Step 4',
    title: 'Unpacking & Placement',
    description:
      'Our team unboxes and unwraps every single item, carefully placing decor, kitchenware, and furniture where you direct.',
    icon: 'tabler:home-ribbon',
  },
]}
  

    >
      <Fragment slot="bg">
      <div
        class="absolute inset-0 bg-[radial-gradient(60%_55%_at_15%_20%,rgb(129_140_248/0.28),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(244_114_182/0.22),transparent_65%)] dark:bg-[radial-gradient(60%_55%_at_15%_20%,rgb(99_102_241/0.25),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(217_70_239/0.18),transparent_65%)]"
      >
      </div>
    </Fragment>
</Timeline>


  <!-- On phones the hero button is long gone; the bar brings the click back once the reader scrolls -->

  <StickyCTA text="Get the template" href={destination} target="_blank" label="One destination, three placements" />
</Layout>
