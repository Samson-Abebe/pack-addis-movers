        socials: [{ icon: 'tabler:brand-linkedin', href: 'https://www.linkedin.com/', ariaLabel: 'LinkedIn' }],
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Our locations"
    tagline="Find us"
    columns={4}
    items={[
      {
        title: 'Location',
        description: '1234 Lorem Ipsum St, 12345, Miami',
      },
      {
        title: 'Telephone',
        description: '5678 Lorem Ipsum St, 56789, Madrid',
      },
      {
