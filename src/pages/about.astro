---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';

import Team from '~/components/widgets/Team.astro';
import Timeline from '~/components/widgets/Timeline.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About us',
  description:
    'About page demo built with AstroWind: hero, stats, feature grids and timelines ready to describe your company.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About us"
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Caos Image',
    }}
  >
    <Fragment slot="title">
      Elevate your online presence with our <br />
      <span class="text-accent dark:text-white"> Beautiful Website Templates</span>
    </Fragment>

    <Fragment slot="subtitle">
      Donec efficitur, ipsum quis congue luctus, mauris magna convallis mauris, eu auctor nisi lectus non augue. Donec
      quis lorem non massa vulputate efficitur ac at turpis. Sed tincidunt ex a nunc convallis, et lobortis nisi tempus.
      Suspendisse vitae nisi eget tortor luctus maximus sed non lectus.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Statistics about us"
    countUp
    stats={[
      { title: 'Offices', amount: '4' },
      { title: 'Employees', amount: '248' },
      { title: 'Templates', amount: '12' },
      { title: 'Awards', amount: '24' },
    ]}
  />
  

  <!-- Features3 Widget ************** -->

  <Features3
    title="Our Moving Services"
    subtitle="From office and residential relocations to electronics transportation and special-item packing, we handle every move with care, safety, and reliability."
    columns={3}
    isBeforeContent={true}
    items={[
    {
  title: 'Corporate & Office Relocation',
  description:
    'We carefully pack, load, transport, unpack, and reassemble office furniture and equipment to help businesses relocate smoothly.',
  icon: 'tabler:building',
},
{
  title: 'Full Residential Moving',
  description:
    'We move villas, apartments, condominiums, and high-rise homes with careful handling to protect your belongings.',
  icon: 'tabler:home',
},
{
  title: 'Electronics & TV Mounting',
  description:
    'We provide protective packing and careful transportation for large smart TVs and other valuable electronic equipment, with installation support where available.',
  icon: 'tabler:device-tv',
},
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
 
  {
    title: 'Residential Moving',
    description:
      'Move your household belongings safely and easily with our careful packing, loading, and transportation services.',
    icon: 'tabler:home',
  },
  {
    title: 'Commercial Moving',
    description:
      'Relocate offices, shops, and business equipment with organized planning and minimal disruption to your work.',
    icon: 'tabler:building',
  },
  {
    title: 'Packing Services',
    description:
      'Protect your belongings with careful packing and organized preparation for a smooth and secure move.',
    icon: 'tabler:package',
  },
  {
    title: 'Loading and Unloading',
    description:
      'Our team handles your furniture, boxes, and other belongings carefully during loading and unloading.',
    icon: 'tabler:truck-loading',
  },
  {
    title: 'Furniture Transportation',
    description:
      'Transport furniture and household items with care from your current location to your new destination.',
    icon: 'tabler:truck',
  },
  {
    title: 'Reliable Delivery',
    description:
      'We prioritize safe handling, clear communication, and timely delivery to make your moving experience easier.',
    icon: 'tabler:clock-check',
  },
]}
    image={{
      src: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: 'Colorful Image',
    }}
  />

  <!-- Steps2 Widget ****************** -->

 

  <!-- Timeline Widget **************** -->

  <Timeline
    id="history"
    tagline="Our story"
    title="Achievements"
    subtitle="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Morbi sagittis, quam nec venenatis lobortis, mi risus tempus nulla, sed porttitor est nibh at nulla."
    layout="alternate"
    items={[
      {
        date: '2019',
        title: 'The first template',
        description: 'Nam malesuada urna in enim imperdiet tincidunt. Phasellus non tincidunt nisi, at elementum mi.',
        icon: 'tabler:rocket',
      },
      {
        date: '2021',
        title: 'Global reach',
        description:
          'Cras semper nulla leo, eget laoreet erat cursus sed. Praesent faucibus massa in purus iaculis dictum.',
        icon: 'tabler:globe',
      },
      {
        date: '2023',
        title: 'Positive customer feedback and reviews',
        description:
          'Phasellus lacinia cursus velit, eu malesuada magna pretium eu. Etiam aliquet tellus purus, blandit lobortis ex rhoncus vitae.',
        icon: 'tabler:message-star',
      },
      {
        date: '2026',
        title: 'Awards and recognition as industry experts',
        description: 'Donec nec justo eget felis facilisis fermentum. Aliquam porttitor mauris sit amet orci.',
        icon: 'tabler:award',
        highlight: true,
      },
    ]}
  />

  <!-- Team Widget ******************** -->

  <Team
    id="team"
    tagline="The people"
    title="Meet the team"
    subtitle="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Morbi sagittis, quam nec venenatis lobortis, mi risus tempus nulla."
    members={[
      {
        name: 'Alicia Rivera',
        role: 'Founder & CEO',
        image: {
          src: 'https://images.unsplash.com/photo-1618835962148-cf177563c6c0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=930&q=80',
          alt: 'Alicia Rivera',
        },
        bio: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.',
        socials: [
          { icon: 'tabler:brand-linkedin', href: 'https://www.linkedin.com/', ariaLabel: 'LinkedIn' },
          { icon: 'tabler:brand-x', href: 'https://x.com/', ariaLabel: 'X' },
        ],
      },
      {
        name: 'Daniel Okafor',
        role: 'Lead developer',
        image: {
          src: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80',
          alt: 'Daniel Okafor',
        },
        bio: 'Morbi sagittis, quam nec venenatis lobortis, mi risus tempus nulla.',
